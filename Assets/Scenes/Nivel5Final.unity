      propertyPath: 'dialogueLines.Array.data[0]'
      value: 'VERDE: volvi loquito'
      objectReference: {fileID: 0}
    - target: {fileID: 5028143981301038619, guid: 867e22776867be64387bb0a3d461c60b, type: 3}
      propertyPath: 'dialogueLines.Array.data[1]'
      value: 'AZUL: ah laburaste una banda vos eh, 12 monedas justo. Ahi esta la
        llave de la casa todda tuya maestro'
      objectReference: {fileID: 0}
    - target: {fileID: 5028143981301038619, guid: 867e22776867be64387bb0a3d461c60b, type: 3}
      propertyPath: 'dialogueLines.Array.data[2]'
      value: 'VERDE: aura'
      objectReference: {fileID: 0}
    - target: {fileID: 5028143981301038619, guid: 867e22776867be64387bb0a3d461c60b, type: 3}
      propertyPath: dialogueConMonedas.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 5028143981301038619, guid: 867e22776867be64387bb0a3d461c60b, type: 3}
      propertyPath: dialogueSinMonedas.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 5028143981301038619, guid: 867e22776867be64387bb0a3d461c60b, type: 3}
      propertyPath: 'dialogueConMonedas.Array.data[0]'
      value: 'DINOBRO: Volvi de laburar, tengo las 12 monedas! :D'
      objectReference: {fileID: 0}
    - target: {fileID: 5028143981301038619, guid: 867e22776867be64387bb0a3d461c60b, type: 3}
      propertyPath: 'dialogueConMonedas.Array.data[1]'
      value: 'DINOAZUL: Ah laburaste una banda vos eh, 12 monedas justo. Ahi esta
        la llave de la casa, toda tuya maestro'
      objectReference: {fileID: 0}
    - target: {fileID: 5028143981301038619, guid: 867e22776867be64387bb0a3d461c60b, type: 3}
      propertyPath: 'dialogueConMonedas.Array.data[2]'
      value: 'DINOBRO: Aura'
      objectReference: {fileID: 0}
    - target: {fileID: 5028143981301038619, guid: 867e22776867be64387bb0a3d461c60b, type: 3}
      propertyPath: 'dialogueConMonedas.Array.data[3]'
      value: 'DINOAZUL: Igual me la olvide ahi arriba que bolu'
      objectReference: {fileID: 0}
    - target: {fileID: 5028143981301038619, guid: 867e22776867be64387bb0a3d461c60b, type: 3}
      propertyPath: 'dialogueConMonedas.Array.data[4]'
      value: 'DINOBRO: Laura'
      objectReference: {fileID: 0}
    - target: {fileID: 5028143981301038619, guid: 867e22776867be64387bb0a3d461c60b, type: 3}
      propertyPath: 'dialogueSinMonedas.Array.data[0]'
      value: 'DINOBRO: Volvi de laburar, podemos discutir precio?'
      objectReference: {fileID: 0}
    - target: {fileID: 5028143981301038619, guid: 867e22776867be64387bb0a3d461c60b, type: 3}
      propertyPath: 'dialogueSinMonedas.Array.data[1]'
      value: 'DINORATA: No, el precio es fijo'
      objectReference: {fileID: 0}
    - target: {fileID: 5028143981301038619, guid: 867e22776867be64387bb0a3d461c60b, type: 3}
      propertyPath: 'dialogueSinMonedas.Array.data[2]'
      value: 'DINOBRO: Dale porfa me rompi el lomo y me cagaron sopapeando un monton
        de veces'
      objectReference: {fileID: 0}
    - target: {fileID: 5028143981301038619, guid: 867e22776867be64387bb0a3d461c60b, type: 3}
      propertyPath: 'dialogueSinMonedas.Array.data[3]'
      value: 'DINORATA: Ajo y agua, segui viviendo en la calle dinonoob '
      objectReference: {fileID: 0}
    - target: {fileID: 5028143981301038619, guid: 867e22776867be64387bb0a3d461c60b, type: 3}
      propertyPath: 'dialogueSinMonedas.Array.data[4]'
      value: 'DINOBRO: Esto no va a quedar asi... '
      objectReference: {fileID: 0}
